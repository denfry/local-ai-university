# Copy this file to .env and adjust values. Never commit the real .env.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.2
OLLAMA_CONTEXT_LENGTH=8192

# --- Obsidian ---
OBSIDIAN_VAULT_PATH=./vault

# --- Database ---
AIU_DATABASE_PATH=./data/aiu.db

# --- Safety limits (see docs/security.md) ---
AIU_ALLOW_WEB_ACCESS=true
AIU_ALLOW_CODE_EXECUTION=true
AIU_MAX_WEB_REQUESTS_PER_SESSION=20
AIU_MAX_LLM_CALLS_PER_SESSION=100
AIU_MAX_ITERATIONS=10
AIU_EXECUTION_TIMEOUT_SECONDS=10
AIU_MAX_SOURCE_SIZE_BYTES=2000000
